FROM ubuntu:22.04 AS base
RUN rm /bin/sh && ln -s /bin/bash /bin/sh

# Use NodeJS v24.11.0
ENV NVM_DIR /usr/local/nvm
ENV NODE_VERSION 24.11.0

# Install OS packages and dependencies
RUN DEBIAN_FRONTEND=noninteractive \
  apt-get update \
  && apt-get install -y ffmpeg \
  && apt-get install -y python3 \
  && apt-get install -y python3-pip \
  && apt-get install -y git \
  && apt-get install -y curl \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p $NVM_DIR \
  && mkdir /opt/app \
  && curl https://raw.githubusercontent.com/creationix/nvm/v0.40.7/install.sh | bash \
  && . $NVM_DIR/nvm.sh \
  && nvm install $NODE_VERSION \
  && nvm alias default $NODE_VERSION \
  && nvm use default

# Create a non-root user and give it ownership of the app and nvm directories
RUN useradd --create-home --shell /bin/bash node \
  && chown -R node:node /opt/app "$NVM_DIR"

# Create app directory and set ownership
WORKDIR /opt/app
RUN mkdir -p \
  /opt/app/node_modules \
  /opt/app/.next \
  /opt/app/node_modules/.vite \
  /opt/app/node_modules/.tmp \
  && chown -R node:node /opt/app

# Persist NodeJS
ENV NODE_PATH $NVM_DIR/versions/node/v$NODE_VERSION/bin
ENV PATH $NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH

# Install Playwright with Chromium into a shared path (not /root/.cache)
# so the non-root user can read/execute the browser binaries later.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN mkdir -p "${PLAYWRIGHT_BROWSERS_PATH}" \
  && npm install -g playwright \
  && playwright install --with-deps chromium \
  && ln -s "$(find "${PLAYWRIGHT_BROWSERS_PATH}"/chromium-* -type f -name chrome | head -n 1)" /usr/local/bin/chromium \
  && chown -R node:node "${PLAYWRIGHT_BROWSERS_PATH}"
ENV CHROME_PATH="/usr/local/bin/chromium"

# Switch to the non-root user
USER node
ENV PATH="/home/node/.local/bin:${PATH}"

# Install Claude Code using the official Linux installer
RUN curl -fsSL https://claude.ai/install.sh | bash
RUN claude --version

# Use a more appropriate entrypoint
CMD ["bash"]
